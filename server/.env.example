# ===== Server =====
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ===== Database =====
# Option A (recommended): full connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.oxxm6.mongodb.net/dr-shivalika?appName=Cluster0
# Option B: individual parts (used if MONGODB_URI is not set)
DB_USER=
DB_PASSWORD=
DB_CLUSTER=cluster0.oxxm6.mongodb.net
DB_APPNAME=Cluster0

# ===== JWT =====
JWT_SECRET=change_me_access_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# ===== Email (Gmail App Password) =====
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM="Dr. Shivalika Platform <no-reply@example.com>"

# ===== SMS (Twilio) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===== Payments (Razorpay) =====
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===== Media (Cloudinary) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Misc =====
OTP_EXPIRY_MINUTES=15
