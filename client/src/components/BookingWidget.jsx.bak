import React, { useEffect, useMemo, useState } from 'react';
import { motion } from 'framer-motion';
import { CalendarPlus, CreditCard, ShieldCheck } from 'lucide-react';
import api from '../services/api.js';

const STEPS = ['Service', 'Details', 'Verify', 'Done'];
const inputCls = 'w-full rounded-2xl border border-[#F1D7D1] bg-white/80 px-4 py-3 text-[15px] text-[#1C1B1F] placeholder:text-[#8E7D7A] shadow-[inset_0_1px_0_rgba(255,255,255,0.8)] focus:border-[#D33616] focus:outline-none focus:ring-4 focus:ring-[#D33616]/10 transition-all';

function buildICS({ reference, service, date, timeSlot, duration }) {
  const [h, m] = (timeSlot || '09:00').split(':').map(Number);
  const start = new Date(`${date}T00:00:00`);
  start.setHours(h, m, 0, 0);
  const end = new Date(start.getTime() + (duration || 30) * 60000);
  const fmt = (d) => d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
  return [
    'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//DrShivalika//Booking//EN',
    'BEGIN:VEVENT',
    `UID:${reference}@drshivalika`,
    `DTSTAMP:${fmt(new Date())}`,
    `DTSTART:${fmt(start)}`,
    `DTEND:${fmt(end)}`,
    `SUMMARY:Dental Appointment — ${service}`,
    `DESCRIPTION:Booking reference ${reference}. Please arrive 10 minutes early.`,
    'LOCATION:Dr. Shivalika Saraswat Dental Clinic',
    'END:VEVENT', 'END:VCALENDAR',
  ].join('\r\n');
}

function downloadICS(booking) {
  const blob = new Blob([buildICS(booking)], { type: 'text/calendar;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `appointment-${booking.reference}.ics`;
  a.click();
  URL.revokeObjectURL(url);
}

function loadRazorpay() {
  return new Promise((resolve) => {
    if (window.Razorpay) return resolve(true);
    const s = document.createElement('script');
    s.src = 'https://checkout.razorpay.com/v1/checkout.js';
    s.onload = () => resolve(true);
    s.onerror = () => resolve(false);
    document.body.appendChild(s);
  });
}

export default function BookingWidget() {
  const [step, setStep] = useState(0);
  const [profile, setProfile] = useState(null);
  const [dates, setDates] = useState([]);
  const [selectedDate, setSelectedDate] = useState('');
  const [slots, setSlots] = useState([]);
  const [form, setForm] = useState({ service: '', timeSlot: '', patientName: '', patientEmail: '', patientPhone: '', notes: '', otp: '' });
  const [error, setError] = useState('');
  const [busy, setBusy] = useState(false);
  const [reference, setReference] = useState('');
  const [confirmedBooking, setConfirmedBooking] = useState(null);
  const [payState, setPayState] = useState('idle');

  useEffect(() => {
    api.get('/profile').then(({ data }) => setProfile(data.data)).catch(() => setProfile(null));
    const days = [...Array(14)].map((_, i) => {
      const d = new Date();
      d.setDate(d.getDate() + i);
      return d;
    });
    setDates(days);
    setSelectedDate(days[1]?.toISOString().slice(0, 10) || '');

    const prefill = (e) => {
      const { service } = e.detail || {};
      if (service) setForm((f) => ({ ...f, service, timeSlot: '' }));
      setStep(0);
    };
    window.addEventListener('booking:prefill', prefill);
    return () => window.removeEventListener('booking:prefill', prefill);
  }, []);

  useEffect(() => {
    if (!selectedDate || step >= 3) return;
    setSlots([]);
    api.get(`/bookings/availability?date=${selectedDate}`)
      .then(({ data }) => setSlots(data.data.slots || []))
      .catch(() => setSlots([]));
  }, [selectedDate, step]);

  const selectedService = useMemo(
    () => profile?.services?.find((s) => s.name === form.service),
    [profile, form.service]
  );

  const set = (k) => (e) => setForm((f) => ({ ...f, [k]: e.target.value }));
  const next = () => setStep((s) => Math.min(s + 1, 3));
  const back = () => { setError(''); setStep((s) => Math.max(s - 1, 0)); };

  const requestOtp = async () => {
    setError('');
    setBusy(true);
    try {
      const { data } = await api.post('/bookings/send-otp', { email: form.patientEmail });
      if (data?.devMode) {
        setError('Email delivery is not configured on the server. Add GMAIL_USER and GMAIL_APP_PASSWORD in server/.env to receive OTP emails. The OTP is printed in the server console for testing.');
      } else {
        next();
      }
    } catch (e) {
      setError(e.response?.data?.message || 'Failed to send OTP');
    } finally {
      setBusy(false);
    }
  };

  const confirmBooking = async () => {
    setError('');
    setBusy(true);
    try {
      const { data } = await api.post('/bookings', {
        doctorId: profile?._id,
        patientName: form.patientName,
        patientEmail: form.patientEmail,
        patientPhone: form.patientPhone,
        service: form.service,
        appointmentDate: selectedDate,
        timeSlot: form.timeSlot,
        notes: form.notes,
        otp: form.otp,
      });
      setReference(data.data.bookingReference);
      setConfirmedBooking({
        reference: data.data.bookingReference,
        service: form.service,
        date: selectedDate,
        timeSlot: form.timeSlot,
        duration: selectedService?.duration || 30,
        price: selectedService?.price || 0,
      });
      setPayState('idle');
      next();
    } catch (e) {
      setError(e.response?.data?.message || 'Booking failed');
    } finally {
      setBusy(false);
    }
  };

  const payOnline = async () => {
    if (!confirmedBooking) return;
    const key = import.meta.env.VITE_RAZORPAY_KEY_ID;
    setPayState('paying');
    const ok = key && (await loadRazorpay());
    if (!ok) {
      setPayState('unavailable');
      return;
    }
    const rzp = new window.Razorpay({
      key,
      amount: confirmedBooking.price * 100,
      currency: 'INR',
      name: 'Dr. Shivalika Saraswat',
      description: `${confirmedBooking.service} — ${confirmedBooking.reference}`,
      theme: { color: '#D33616' },
      prefill: { name: form.patientName, email: form.patientEmail, contact: form.patientPhone },
      handler: () => setPayState('paid'),
      modal: { ondismiss: () => setPayState('idle') },
    });
    rzp.open();
  };

  return (
    <section id="booking" className="relative overflow-hidden py-24">
      <div className="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(211,54,22,0.12),transparent_26%),radial-gradient(circle_at_bottom_right,rgba(207,137,118,0.14),transparent_30%)]" />
      <div className="relative mx-auto max-w-5xl px-6">
        <div className="mb-10 text-center">
          <div className="mb-4 inline-flex items-center gap-2 rounded-full border border-[#E8DAD5] bg-white/70 px-4 py-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#D33616] shadow-[0_12px_24px_rgba(105,10,1,0.04)] backdrop-blur-md">
            <ShieldCheck size={15} /> Secure Booking
          </div>
          <h2 className="text-4xl font-black tracking-[-0.08em] text-[#690A01] md:text-5xl">Reserve Your Appointment</h2>
          <p className="mt-4 text-base text-[#6E6D7A]">Instant confirmation · OTP-verified · Free rescheduling</p>
        </div>

        <div className="glass relative overflow-hidden rounded-[2rem] border border-white/70 bg-white/65 p-5 shadow-[0_30px_70px_rgba(105,10,1,0.08)] backdrop-blur-2xl md:p-8">
          <div className="absolute -right-10 top-0 h-40 w-40 rounded-full bg-[#D33616]/10 blur-3xl" />
          <div className="absolute -left-12 bottom-0 h-32 w-32 rounded-full bg-[#CF8976]/10 blur-3xl" />

          <div className="relative">
            <StepIndicator step={step} />
            {error && <div className="mb-6 rounded-2xl border border-red-200 bg-red-50/90 p-3 text-center text-sm font-medium text-red-700 shadow-[0_8px_20px_rgba(239,68,68,0.08)]">{error}</div>}
            {step === 0 && <ServiceStep profile={profile} dates={dates} selectedDate={selectedDate} setSelectedDate={setSelectedDate} slots={slots} form={form} setForm={setForm} next={next} />}
            {step === 1 && <DetailsStep form={form} set={set} selectedDate={selectedDate} selectedService={selectedService} back={back} requestOtp={requestOtp} busy={busy} />}
            {step === 2 && <OtpStep form={form} set={set} back={back} confirmBooking={confirmBooking} busy={busy} />}
            {step === 3 && (
              <DoneStep
                booking={confirmedBooking}
                payState={payState}
                onPay={payOnline}
                onDownload={downloadICS}
              />
            )}
          </div>
        </div>
      </div>
    </section>
  );
}

function StepIndicator({ step }) {
  return (
    <div className="mb-8 flex flex-wrap items-center justify-center gap-2 md:gap-3">
      {STEPS.map((label, i) => (
        <div key={label} className="flex items-center gap-2.5">
          <div className={`flex h-9 w-9 items-center justify-center rounded-full border text-sm font-bold transition-all ${i <= step ? 'border-[#D33616] bg-gradient-to-br from-[#D33616] to-[#B5210A] text-white shadow-[0_12px_25px_rgba(211,54,22,0.22)]' : 'border-[#E8DAD5] bg-white/70 text-[#817C83]'}`}>
            {i + 1}
          </div>
          <span className={`text-[11px] font-semibold uppercase tracking-[0.16em] ${i <= step ? 'text-[#D33616]' : 'text-[#817C83]'}`}>{label}</span>
          {i < STEPS.length - 1 && <div className={`h-px w-6 md:w-8 ${i < step ? 'bg-[#D33616]/60' : 'bg-[#E8DAD5]'}`} />}
        </div>
      ))}
    </div>
  );
}

function ServiceStep({ profile, dates, selectedDate, setSelectedDate, slots, form, setForm, next }) {
  return (
    <div className="space-y-6">
      <div>
        <label className="mb-3 block text-[11px] font-bold uppercase tracking-[0.18em] text-[#690A01]">Select Service</label>
        <div className="grid gap-3">
          {(profile?.services || []).map((s) => (
            <button
              key={s.name}
              onClick={() => setForm((f) => ({ ...f, service: s.name, timeSlot: '' }))}
              className={`group rounded-[1.5rem] border p-4 text-left transition-all duration-300 ${form.service === s.name ? 'border-[#D33616]/60 bg-[linear-gradient(135deg,rgba(255,249,247,1),rgba(255,238,234,0.9))] shadow-[0_18px_35px_rgba(211,54,22,0.08)]' : 'border-[#F0E3DF] bg-white/65 hover:-translate-y-0.5 hover:border-[#D33616]/35 hover:shadow-[0_18px_35px_rgba(105,10,1,0.06)]'}`}
            >
              <div className="flex items-center justify-between gap-3">
                <span className="text-base font-bold text-[#1C1B1F]">{s.name}</span>
                <span className="rounded-full bg-[#FDEAE5] px-3 py-1 text-sm font-bold text-[#D33616]">₹{s.price}</span>
              </div>
              <p className="mt-2 text-sm leading-6 text-[#6E6D7A]">{s.description} · {s.duration} min</p>
            </button>
          ))}
          {!profile && <p className="text-center text-sm text-[#6E6D7A]">Loading services…</p>}
        </div>
      </div>

      <div>
        <label className="mb-3 block text-[11px] font-bold uppercase tracking-[0.18em] text-[#690A01]">Pick a Date</label>
        <div className="rounded-[1.5rem] border border-[#F0E3DF] bg-white/65 p-2.5 shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]">
          <select value={selectedDate} onChange={(e) => setSelectedDate(e.target.value)} className={`${inputCls} appearance-none bg-transparent`}>
            {dates.map((d) => (
              <option key={d.toISOString()} value={d.toISOString().slice(0, 10)}>
                {d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' })}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div>
        <label className="mb-3 block text-[11px] font-bold uppercase tracking-[0.18em] text-[#690A01]">Available Slots</label>
        <div className="grid grid-cols-4 gap-2.5">
          {(slots.length ? slots : Array.from({ length: 8 }, () => null)).map((s, i) =>
            s ? (
              <button
                key={s.slot}
                disabled={!s.available}
                onClick={() => setForm((f) => ({ ...f, timeSlot: s.slot }))}
                className={`rounded-2xl border py-2.5 text-sm font-semibold transition-all ${form.timeSlot === s.slot ? 'border-[#D33616] bg-gradient-to-br from-[#D33616] to-[#B5210A] text-white shadow-[0_15px_30px_rgba(211,54,22,0.2)]' : s.available ? 'border-[#F0E3DF] bg-white/70 text-[#403E45] hover:border-[#D33616]/40 hover:text-[#D33616]' : 'cursor-not-allowed border-[#F5E9E4] bg-[#F8F1EF] text-[#B6A8A1] line-through'}`}
              >
                {s.slot}
              </button>
            ) : (
              <div key={i} className="animate-pulse rounded-2xl bg-[#F4EAE6] py-2.5" />
            )
          )}
        </div>
      </div>

      <button onClick={next} disabled={!form.service || !form.timeSlot} className="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-40">
        Next
      </button>
    </div>
  );
}

function DetailsStep({ form, set, selectedDate, selectedService, back, requestOtp, busy }) {
  const valid =
    form.patientName.trim().length >= 2 &&
    /^\S+@\S+\.\S+$/.test(form.patientEmail) &&
    /^[0-9]{10}$/.test(form.patientPhone);

  return (
    <div className="space-y-5">
      <div>
        <label className="mb-2 block text-[11px] font-bold uppercase tracking-[0.18em] text-[#690A01]">Full Name</label>
        <input value={form.patientName} onChange={set('patientName')} className={inputCls} placeholder="Your name" />
      </div>
      <div>
        <label className="mb-2 block text-[11px] font-bold uppercase tracking-[0.18em] text-[#690A01]">Email</label>
        <input type="email" value={form.patientEmail} onChange={set('patientEmail')} className={inputCls} placeholder="your@email.com" />
      </div>
      <div>
        <label className="mb-2 block text-[11px] font-bold uppercase tracking-[0.18em] text-[#690A01]">Phone (10 digits)</label>
        <input value={form.patientPhone} onChange={set('patientPhone')} className={inputCls} placeholder="9876543210" maxLength="10" />
      </div>
      <div>
        <label className="mb-2 block text-[11px] font-bold uppercase tracking-[0.18em] text-[#690A01]">Notes (optional)</label>
        <textarea value={form.notes} onChange={set('notes')} className={`${inputCls} min-h-[110px] resize-none`} rows="3" placeholder="Anything the doctor should know…" />
      </div>
      <div className="rounded-[1.5rem] border border-[#F0E3DF] bg-[linear-gradient(135deg,rgba(255,255,255,0.9),rgba(255,244,240,0.9))] p-4 text-sm leading-7 text-[#403E45] shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]">
        <div className="mb-1 text-[11px] font-bold uppercase tracking-[0.18em] text-[#690A01]">Summary</div>
        <div className="font-medium text-[#1C1B1F]">{form.service} · {selectedDate} at {form.timeSlot}</div>
        {selectedService ? <div className="mt-1 font-semibold text-[#D33616]">₹{selectedService.price}</div> : null}
      </div>
      <div className="flex gap-3 pt-2">
        <button onClick={back} className="btn-ghost flex-1">Back</button>
        <button onClick={requestOtp} disabled={busy || !valid} className="btn-primary flex-1 disabled:cursor-not-allowed disabled:opacity-40">
          {busy ? 'Sending OTP…' : 'Send OTP'}
        </button>
      </div>
    </div>
  );
}

function OtpStep({ form, set, back, confirmBooking, busy }) {
  return (
    <div className="space-y-5">
      <div className="rounded-[1.5rem] border border-[#F0E3DF] bg-white/70 p-4 text-center text-sm text-[#6E6D7A] shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]">
        We’ve sent a 6-digit OTP to <strong className="text-[#690A01]">{form.patientEmail}</strong>
      </div>
      <input
        value={form.otp}
        onChange={set('otp')}
        className={`${inputCls} text-center text-2xl font-bold tracking-[0.7em]`}
        placeholder="000000"
        maxLength="6"
        inputMode="numeric"
      />
      <div className="flex gap-3 pt-2">
        <button onClick={back} className="btn-ghost flex-1">Back</button>
        <button onClick={confirmBooking} disabled={busy || !/^[0-9]{6}$/.test(form.otp)} className="btn-primary flex-1 disabled:cursor-not-allowed disabled:opacity-40">
          {busy ? 'Confirming…' : 'Verify & Confirm'}
        </button>
      </div>
    </div>
  );
}

function DoneStep({ booking, payState, onPay, onDownload }) {
  if (!booking) return null;
  return (
    <motion.div initial={{ opacity: 0, scale: 0.96 }} animate={{ opacity: 1, scale: 1 }} className="py-2 text-center">
      <div className="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-[#D33616] to-[#B5210A] text-3xl text-white shadow-[0_18px_35px_rgba(211,54,22,0.28)]">✓</div>
      <h3 className="mb-2 text-3xl font-black tracking-[-0.06em] text-[#690A01]">Booking Confirmed!</h3>
      <p className="text-sm text-[#6E6D7A]">
        Reference <strong className="tracking-[0.22em] text-[#D33616]">{booking.reference}</strong>
      </p>
      <p className="mt-3 mb-6 text-base text-[#403E45]">
        {booking.service} · {booking.date} at {booking.timeSlot} · ₹{booking.price}
      </p>

      <div className="mb-4 rounded-[1.75rem] border border-[#F0E3DF] bg-[linear-gradient(135deg,rgba(255,255,255,0.9),rgba(255,244,240,0.85))] p-5 shadow-[0_18px_35px_rgba(105,10,1,0.06)]">
        <div className="flex items-center justify-between gap-4">
          <div className="text-left">
            <p className="flex items-center gap-2 text-base font-bold text-[#690A01]"><CreditCard size={16} className="text-[#D33616]" /> Pay online</p>
            <p className="mt-1 text-xs text-[#6E6D7A]">Secure checkout via Razorpay</p>
          </div>
          {payState === 'paid' ? (
            <span className="rounded-full bg-emerald-500/15 px-4 py-1.5 text-sm font-semibold text-emerald-700">Paid ✓</span>
          ) : (
            <button
              onClick={onPay}
              disabled={payState === 'paying'}
              className="btn-primary px-6 py-2.5 text-sm disabled:opacity-50"
            >
              {payState === 'paying' ? 'Opening…' : `Pay ₹${booking.price}`}
            </button>
          )}
        </div>
        {payState === 'unavailable' && (
          <p className="mt-3 text-left text-xs text-amber-700">
            Online payment is unavailable right now — you can pay at the clinic. Your appointment is confirmed.
          </p>
        )}
      </div>

      <button onClick={() => onDownload(booking)} className="btn-ghost inline-flex w-full items-center justify-center gap-2">
        <CalendarPlus size={16} /> Add to Calendar (.ics)
      </button>

      <p className="mt-5 text-xs text-[#6E6D7A]">A confirmation has been sent to your email. Please arrive 10 minutes early.</p>
    </motion.div>
  );
}
